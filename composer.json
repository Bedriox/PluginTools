{
  "name": "bedriox/plugin-tools",
  "description": "Deterministic and bounded PHAR packaging tools for Bedriox plugins.",
  "type": "project",
  "license": "GPL-3.0-only",
  "homepage": "https://bedriox.com",
  "require": {"php":"^8.4","ext-phar":"*"},
  "require-dev": {"phpunit/phpunit":"^11.5","phpstan/phpstan":"^2.1","friendsofphp/php-cs-fixer":"^3.75"},
  "autoload": {"psr-4":{"Bedriox\\PluginTools\\":"src/"}},
  "autoload-dev": {"psr-4":{"Bedriox\\PluginTools\\Tests\\":"tests/","Bedriox\\Api\\":"tests/Stubs/Api/"}},
  "bin": ["bin/plugin-tools"],
  "scripts": {"test":"php -d phar.readonly=0 vendor/bin/phpunit","analyse":"phpstan analyse --no-progress --memory-limit=512M","style":"php-cs-fixer check --diff","check":["@test","@analyse","@style"]},
  "config": {"allow-plugins":false,"sort-packages":true},
  "minimum-stability":"stable","prefer-stable":true
}
